@host = http://localhost:5131
@userId = replace-after-creating-user
@projectId = replace-after-creating-project
@taskId = replace-after-creating-task

POST {{host}}/api/users
Content-Type: application/json

{
  "name": "Ada Lovelace",
  "email": "ada@example.com"
}

###

GET {{host}}/api/users/{{userId}}
Accept: application/json

###

POST {{host}}/api/projects
Content-Type: application/json

{
  "name": "Learn TaskFlow",
  "ownerId": "{{userId}}",
  "description": "Trace a request through every layer"
}

###

GET {{host}}/api/projects?ownerId={{userId}}
Accept: application/json

###

POST {{host}}/api/tasks
Content-Type: application/json

{
  "projectId": "{{projectId}}",
  "title": "Complete the API layer",
  "priority": "High",
  "description": "Controllers, DI and middleware"
}

###

PATCH {{host}}/api/tasks/{{taskId}}/complete
Accept: application/json

###

PATCH {{host}}/api/tasks/{{taskId}}/assignee
Content-Type: application/json

{
  "assigneeId": "{{userId}}"
}
