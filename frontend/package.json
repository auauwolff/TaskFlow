{
  "name": "taskflow-frontend",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "architecture": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "generate:api": "openapi-typescript http://localhost:5131/openapi/v1.json -o src/shared/api/schema.d.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@xstate/react": "^6.1.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.22",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "dependency-cruiser": "^17.3.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.71.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "ajv": "^8.18.0",
      "picomatch": "^4.0.4"
    }
  }
}
